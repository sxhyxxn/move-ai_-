# 7. 지도
# ============================================================

def node_to_lonlat(node, transformer):
    lon, lat = transformer.transform(
        float(node[0]),
        float(node[1]),
    )

    return [lon, lat]



def compute_map_view(route_df, vehicle_df, delivery_points, depot_points):
    lons = []
    lats = []

    if route_df is not None and not route_df.empty:
        for path in route_df["path"]:
            for lon, lat in path:
                if np.isfinite(lon) and np.isfinite(lat):
                    lons.append(float(lon))
                    lats.append(float(lat))

    if vehicle_df is not None and not vehicle_df.empty:
        for _, row in vehicle_df.iterrows():
            if np.isfinite(row["lon"]) and np.isfinite(row["lat"]):
                lons.append(float(row["lon"]))
                lats.append(float(row["lat"]))

    if not lons:
        for _, row in delivery_points.iterrows():
            if np.isfinite(row["lon"]) and np.isfinite(row["lat"]):
                lons.append(float(row["lon"]))
                lats.append(float(row["lat"]))

    if not lons:
        lons = [float(depot_points.iloc[0]["lon"])]
        lats = [float(depot_points.iloc[0]["lat"])]

    min_lon, max_lon = min(lons), max(lons)
    min_lat, max_lat = min(lats), max(lats)

    center_lon = (min_lon + max_lon) / 2
    center_lat = (min_lat + max_lat) / 2

    lon_span = max(max_lon - min_lon, 0.001)
    lat_span = max(max_lat - min_lat, 0.001)
    span = max(lon_span, lat_span)

    if span < 0.01:
        zoom = 13.5
    elif span < 0.03:
        zoom = 12.5
    elif span < 0.07:
        zoom = 11.5
    elif span < 0.15:
        zoom = 10.5
    else:
        zoom = 9.5

    return pdk.ViewState(
        longitude=center_lon,
        latitude=center_lat,
        zoom=zoom,
        pitch=0,
    )


def build_map_layers(
    G,
    states,
    route_override,
    depot_node,
    delivery_nodes,
    transformer,
    deliveries_df,
    depot_df,
):
    route_rows = []
    vehicle_rows = []

    for vehicle_id, state in states.items():
        color = VEHICLE_COLORS.get(
            vehicle_id,
            [90, 90, 90],
        )

        lon, lat = node_to_lonlat(
            state["current_node"],
            transformer,
        )

        vehicle_rows.append({
            "vehicle_id": vehicle_id,
            "차량": f"차량 {vehicle_id}",
            "상태": state["status"],
            "lon": lon,
            "lat": lat,
            "color": color if state["active"] else [80, 80, 80],
        })

        if not state["active"]:
            continue

        route = route_override.get(
            vehicle_id,
            state["remaining_route"],
        )

        path_nodes = get_route_path_nodes(
            G,
            state,
            route,
            depot_node,
            delivery_nodes,
        )

        if path_nodes:
            route_rows.append({
                "vehicle_id": vehicle_id,
                "차량": f"차량 {vehicle_id}",
                "path": [
                    node_to_lonlat(node, transformer)
                    for node in path_nodes
                ],
                "color": color,
            })

    route_df = pd.DataFrame(route_rows)
    vehicle_df = pd.DataFrame(vehicle_rows)

    delivery_points = deliveries_df[
        ["name", "lon", "lat"]
    ].copy()

    depot_points = pd.DataFrame([{
        "name": "물류센터",
        "lon": float(depot_df.iloc[0]["lon"]),
        "lat": float(depot_df.iloc[0]["lat"]),
    }])

    layers = []

    if not route_df.empty:
        layers.append(
            pdk.Layer(
                "PathLayer",
                data=route_df,
                get_path="path",
                get_color="color",
                width_min_pixels=4,
                pickable=True,
            )
        )

    layers.extend([
        pdk.Layer(
            "ScatterplotLayer",
            data=delivery_points,
            get_position="[lon, lat]",
            get_radius=55,
            get_fill_color=[110, 110, 110, 150],
            pickable=True,
        ),
        pdk.Layer(
            "ScatterplotLayer",
            data=depot_points,
            get_position="[lon, lat]",
            get_radius=100,
            get_fill_color=[0, 0, 0, 210],
            pickable=True,
        ),
    ])

    if not vehicle_df.empty:
        layers.append(
            pdk.Layer(
                "ScatterplotLayer",
                data=vehicle_df,
                get_position="[lon, lat]",
                get_radius=120,
                get_fill_color="color",
                get_line_color=[255, 255, 255],
                line_width_min_pixels=2,
                stroked=True,
                pickable=True,
            )
        )

    view_state = compute_map_view(
        route_df=route_df,
        vehicle_df=vehicle_df,
        delivery_points=delivery_points,
        depot_points=depot_points,
    )

    deck = pdk.Deck(
        layers=layers,
        initial_view_state=view_state,
        map_style="light",
        tooltip={
            "html": "<b>{차량}</b><br>{상태}<br>{name}"
        },
    )

    return deck


