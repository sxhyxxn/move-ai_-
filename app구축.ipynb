# ============================================================
# 1. 공통 함수
# ============================================================

def check_required_files():
    required = [
        ROAD_SHP_PATH,
        DEPOT_PATH,
        DRIVERS_PATH,
        DELIVERIES_PATH,
        KNOWLEDGE_PATH,
        ROUTES_BEFORE_PATH,
    ]

    missing = [str(p) for p in required if not p.exists()]

    if missing:
        st.error("필수 파일을 찾을 수 없습니다.")
        st.code("\n".join(missing))
        st.stop()


def extract_delivery_names(route_string):
    return re.findall(r"배송지_\d+", str(route_string))


def round_node(x, y):
    return (round(float(x), 2), round(float(y), 2))


def add_line_to_graph(G, line, speed_kmh):
    coords = list(line.coords)

    if len(coords) < 2:
        return

    speed_mps = speed_kmh * 1000 / 3600

    for i in range(len(coords) - 1):
        u = round_node(coords[i][0], coords[i][1])
        v = round_node(coords[i + 1][0], coords[i + 1][1])

        if u == v:
            continue

        length_m = math.hypot(v[0] - u[0], v[1] - u[1])

        if length_m <= 0:
            continue

        travel_time_sec = length_m / speed_mps

        # MVP: 양방향 처리
        G.add_edge(u, v, length_m=length_m, travel_time_sec=travel_time_sec)
        G.add_edge(v, u, length_m=length_m, travel_time_sec=travel_time_sec)


def minmax_normalize(values):
    values = np.asarray(values, dtype=float)

    if len(values) == 0:
        return values

    vmin = np.nanmin(values)
    vmax = np.nanmax(values)

    if (
        not np.isfinite(vmin)
        or not np.isfinite(vmax)
        or abs(vmax - vmin) < 1e-9
    ):
        return np.zeros(len(values))

    return (values - vmin) / (vmax - vmin)


@st.cache_data
def load_base_data():
    return (
        pd.read_csv(DEPOT_PATH),
        pd.read_csv(DRIVERS_PATH),
        pd.read_csv(DELIVERIES_PATH),
        pd.read_csv(KNOWLEDGE_PATH),
        pd.read_csv(ROUTES_BEFORE_PATH),
    )


def make_original_routes(routes_before_df):
    routes = {}

    for _, row in routes_before_df.iterrows():
        vehicle_id = int(row["vehicle_id"])
        routes[vehicle_id] = extract_delivery_names(row["route"])

    return routes


# ============================================================
# 2. 도로망 그래프
# ============================================================

@st.cache_resource(show_spinner="도로 네트워크를 준비하는 중입니다...")
def build_network():
    depot_df = pd.read_csv(DEPOT_PATH)
    drivers_df = pd.read_csv(DRIVERS_PATH)
    deliveries_df = pd.read_csv(DELIVERIES_PATH)

    roads = gpd.read_file(ROAD_SHP_PATH)

    if roads.empty:
        raise ValueError("도로 SHP가 비어 있습니다.")

    if roads.crs is None:
        raise ValueError("도로 SHP의 CRS 정보가 없습니다.")

    roads_m = roads.to_crs(epsg=5179)
    roads_m = roads_m[
        roads_m.geometry.notna()
        & ~roads_m.geometry.is_empty
    ].copy()

    all_x = pd.concat([
        depot_df["node_x"],
        drivers_df["node_x"],
        deliveries_df["node_x"],
    ])

    all_y = pd.concat([
        depot_df["node_y"],
        drivers_df["node_y"],
        deliveries_df["node_y"],
    ])

    xmin = all_x.min() - MARGIN_M
    xmax = all_x.max() + MARGIN_M
    ymin = all_y.min() - MARGIN_M
    ymax = all_y.max() + MARGIN_M

    roads_m = roads_m.cx[xmin:xmax, ymin:ymax].copy()

    if roads_m.empty:
        raise ValueError("분석지역에 해당하는 도로가 없습니다.")

    speed_col = None

    for col in ["MAX_SPD", "MAX_SPEED", "SPEED", "SPD"]:
        if col in roads_m.columns:
            speed_col = col
            break

    G = nx.DiGraph()

    for _, row in roads_m.iterrows():
        speed_kmh = DEFAULT_SPEED_KMH

        if speed_col is not None:
            try:
                value = float(row[speed_col])

                if np.isfinite(value) and value > 0:
                    speed_kmh = value
            except:
                pass

        geom = row.geometry

        if isinstance(geom, LineString):
            add_line_to_graph(G, geom, speed_kmh)

        elif isinstance(geom, MultiLineString):
            for line in geom.geoms:
                add_line_to_graph(G, line, speed_kmh)

    if G.number_of_nodes() == 0:
        raise ValueError("도로 그래프 생성에 실패했습니다.")

    components = list(nx.weakly_connected_components(G))
    largest_component = max(components, key=len)
    G = G.subgraph(largest_component).copy()

    graph_nodes = np.array(list(G.nodes), dtype=float)

    def nearest_graph_node(x, y):
        d2 = (
            (graph_nodes[:, 0] - x) ** 2
            + (graph_nodes[:, 1] - y) ** 2
        )

        idx = np.argmin(d2)
        return tuple(graph_nodes[idx])

    depot_node = nearest_graph_node(
        depot_df.iloc[0]["node_x"],
        depot_df.iloc[0]["node_y"],
    )

    driver_nodes = {}

    for _, row in drivers_df.iterrows():
        vehicle_id = int(row["vehicle_id"])

        driver_nodes[vehicle_id] = nearest_graph_node(
            row["node_x"],
            row["node_y"],
        )

    delivery_nodes = {}

    for _, row in deliveries_df.iterrows():
        delivery_nodes[row["name"]] = nearest_graph_node(
            row["node_x"],
            row["node_y"],
        )

    transformer = Transformer.from_crs(
        "EPSG:5179",
        "EPSG:4326",
        always_xy=True,
    )

    return (
        G,
        depot_node,
        driver_nodes,
        delivery_nodes,
        transformer,
        speed_col,
    )


# ============================================================
# 3. 도로 경로 계산
# ============================================================

PATH_CACHE = {}


def get_path_metrics(G, start_node, end_node):
    key = (start_node, end_node)

    if key in PATH_CACHE:
        return PATH_CACHE[key]

    path = nx.shortest_path(
        G,
        start_node,
        end_node,
        weight="travel_time_sec",
    )

    distance_m = 0.0
    travel_time_sec = 0.0

    for i in range(len(path) - 1):
        edge = G[path[i]][path[i + 1]]

        distance_m += float(edge["length_m"])
        travel_time_sec += float(edge["travel_time_sec"])

    result = {
        "path": path,
        "distance_m": distance_m,
        "travel_time_sec": travel_time_sec,
    }

    PATH_CACHE[key] = result
    return result


def get_node_at_elapsed_seconds(G, path_nodes, elapsed_sec):
    if not path_nodes:
        return None

    if len(path_nodes) == 1 or elapsed_sec <= 0:
        return path_nodes[0]

    cumulative = 0.0

    for i in range(len(path_nodes) - 1):
        edge = G[path_nodes[i]][path_nodes[i + 1]]
        seg_sec = float(edge["travel_time_sec"])

        if cumulative + seg_sec >= elapsed_sec:
            return path_nodes[i]

        cumulative += seg_sec

    return path_nodes[-1]


# ============================================================
# 4. 서비스시간
# ============================================================

def make_service_times(deliveries_df, knowledge_df):
    extra_delay = {
        name: 0
        for name in deliveries_df["name"]
    }

    for _, row in knowledge_df.iterrows():
        location = row["location"]

        if location in extra_delay:
            extra_delay[location] += int(row["extra_delay_min"])

    service_time_min = {}

    for _, row in deliveries_df.iterrows():
        name = row["name"]

        service_time_min[name] = (
            DEFAULT_SERVICE_MIN
            + extra_delay.get(name, 0)
        )

    knowledge_check_df = pd.DataFrame({
        "배송지": deliveries_df["name"],
        "기본서비스시간_min": DEFAULT_SERVICE_MIN,
        "추가지연_min": deliveries_df["name"].map(extra_delay),
        "총서비스시간_min": deliveries_df["name"].map(service_time_min),
    })

    return service_time_min, knowledge_check_df


# ============================================================
# 5. 차량 상태 시뮬레이션
#
# snapshot:
# {
#   current_node,
#   remaining_route,
#   service_remaining_sec,
#   active
# }
#
# epoch_start_min 시점 snapshot에서 현재 sim_time까지 진행
# ============================================================

def simulate_vehicle_from_snapshot(
    G,
    snapshot,
    elapsed_min,
    depot_node,
    delivery_nodes,
    service_time_min,
):
    current_node = snapshot["current_node"]
    route = snapshot["remaining_route"].copy()
    service_remaining_sec = float(
        snapshot.get("service_remaining_sec", 0.0)
    )
    active = bool(snapshot.get("active", True))

    if not active:
        return {
            "current_node": current_node,
            "remaining_route": route,
            "service_remaining_sec": service_remaining_sec,
            "status": "운행 중단",
            "next_delivery": route[0] if route else "-",
            "completed_now": [],
            "active": False,
        }

    remaining_sec = max(0.0, float(elapsed_min) * 60)
    completed_now = []

    # 이전 epoch 시작 시 이미 배송지 서비스 중이었다면 남은 서비스부터 처리
    if service_remaining_sec > 0 and route:
        if remaining_sec < service_remaining_sec:
            return {
                "current_node": current_node,
                "remaining_route": route,
                "service_remaining_sec": service_remaining_sec - remaining_sec,
                "status": f"{route[0]} 배송/하역 중",
                "next_delivery": route[0],
                "completed_now": completed_now,
                "active": True,
            }

        remaining_sec -= service_remaining_sec
        completed_now.append(route[0])
        route = route[1:]
        service_remaining_sec = 0.0

    while route:
        delivery_name = route[0]
        target_node = delivery_nodes[delivery_name]

        path_result = get_path_metrics(
            G,
            current_node,
            target_node,
        )

        travel_sec = path_result["travel_time_sec"]

        if remaining_sec < travel_sec:
            current_node = get_node_at_elapsed_seconds(
                G,
                path_result["path"],
                remaining_sec,
            )

            return {
                "current_node": current_node,
                "remaining_route": route,
                "service_remaining_sec": 0.0,
                "status": f"{delivery_name}로 이동 중",
                "next_delivery": delivery_name,
                "completed_now": completed_now,
                "active": True,
            }

        remaining_sec -= travel_sec
        current_node = target_node

        service_sec = float(service_time_min[delivery_name]) * 60

        if remaining_sec < service_sec:
            return {
                "current_node": current_node,
                "remaining_route": route,
                "service_remaining_sec": service_sec - remaining_sec,
                "status": f"{delivery_name} 배송/하역 중",
                "next_delivery": delivery_name,
                "completed_now": completed_now,
                "active": True,
            }

        remaining_sec -= service_sec
        completed_now.append(delivery_name)
        route = route[1:]

    # 모든 배송 완료 후 물류센터 복귀
    if current_node != depot_node:
        path_result = get_path_metrics(
            G,
            current_node,
            depot_node,
        )

        if remaining_sec < path_result["travel_time_sec"]:
            current_node = get_node_at_elapsed_seconds(
                G,
                path_result["path"],
                remaining_sec,
            )

            return {
                "current_node": current_node,
                "remaining_route": [],
                "service_remaining_sec": 0.0,
                "status": "물류센터 복귀 중",
                "next_delivery": "-",
                "completed_now": completed_now,
                "active": True,
            }

        current_node = depot_node

    return {
        "current_node": current_node,
        "remaining_route": [],
        "service_remaining_sec": 0.0,
        "status": "운행 완료",
        "next_delivery": "-",
        "completed_now": completed_now,
        "active": True,
    }


def get_current_states(
    G,
    epoch_snapshots,
    epoch_start_min,
    sim_time_min,
    depot_node,
    delivery_nodes,
    service_time_min,
):
    elapsed_min = sim_time_min - epoch_start_min

    states = {}

    for vehicle_id, snapshot in epoch_snapshots.items():
        states[vehicle_id] = simulate_vehicle_from_snapshot(
            G=G,
            snapshot=snapshot,
            elapsed_min=elapsed_min,
            depot_node=depot_node,
            delivery_nodes=delivery_nodes,
            service_time_min=service_time_min,
        )

    return states


def states_to_dataframe(states):
    rows = []

    for vehicle_id in sorted(states):
        state = states[vehicle_id]

        rows.append({
            "vehicle_id": vehicle_id,
            "운행상태": state["status"],
            "다음배송": state["next_delivery"],
            "남은배송건수": len(state["remaining_route"]),
            "운행가능": "정상" if state["active"] else "중단",
        })

    return pd.DataFrame(rows)


# ============================================================
# 6. 남은 경로 평가 / 재배차
# ============================================================

def calculate_remaining_route(
    G,
    vehicle_id,
    state,
    delivery_route,
    depot_node,
    delivery_nodes,
    service_time_min,
):
    current_node = state["current_node"]

    total_distance_m = 0.0
    total_travel_time_sec = 0.0
    total_service_min = 0.0

    route = delivery_route.copy()

    # 현재 배송지에서 서비스 중이면
    # 첫 배송지의 전체 서비스시간 대신 남은 서비스시간만 적용
    if state["service_remaining_sec"] > 0 and route:
        total_service_min += state["service_remaining_sec"] / 60
        current_node = delivery_nodes[route[0]]
        route = route[1:]

    for delivery_name in route:
        target_node = delivery_nodes[delivery_name]

        result = get_path_metrics(
            G,
            current_node,
            target_node,
        )

        total_distance_m += result["distance_m"]
        total_travel_time_sec += result["travel_time_sec"]
        total_service_min += service_time_min[delivery_name]

        current_node = target_node

    result = get_path_metrics(
        G,
        current_node,
        depot_node,
    )

    total_distance_m += result["distance_m"]
    total_travel_time_sec += result["travel_time_sec"]

    return {
        "distance_km": total_distance_m / 1000,
        "travel_time_min": total_travel_time_sec / 60,
        "service_time_min": total_service_min,
        "remaining_time_min": (
            total_travel_time_sec / 60
            + total_service_min
        ),
    }


def get_route_path_nodes(
    G,
    state,
    delivery_route,
    depot_node,
    delivery_nodes,
):
    current_node = state["current_node"]
    route = delivery_route.copy()
    full_path = [current_node]

    if state["service_remaining_sec"] > 0 and route:
        current_node = delivery_nodes[route[0]]
        route = route[1:]
        full_path = [current_node]

    for delivery_name in route:
        target_node = delivery_nodes[delivery_name]

        result = get_path_metrics(
            G,
            current_node,
            target_node,
        )

        full_path.extend(result["path"][1:])
        current_node = target_node

    result = get_path_metrics(
        G,
        current_node,
        depot_node,
    )

    full_path.extend(result["path"][1:])

    return full_path


def reassign_failed_vehicle(
    G,
    failed_vehicle,
    current_states,
    depot_node,
    delivery_nodes,
    service_time_min,
    max_remaining_time_min,
):
    failed_state = current_states[failed_vehicle]
    failed_deliveries = failed_state["remaining_route"].copy()

    working_routes = {
        vehicle_id: state["remaining_route"].copy()
        for vehicle_id, state in current_states.items()
        if vehicle_id != failed_vehicle and state["active"]
    }

    candidate_rows = []
    assignment_rows = []
    unassigned_rows = []

    for delivery_name in failed_deliveries:
        candidates = []

        for vehicle_id, current_route in working_routes.items():
            state = current_states[vehicle_id]

            current_metrics = calculate_remaining_route(
                G,
                vehicle_id,
                state,
                current_route,
                depot_node,
                delivery_nodes,
                service_time_min,
            )

            # 현재 배송지 서비스 중이면 그 배송지는 이미 고정
            min_position = (
                1
                if state["service_remaining_sec"] > 0 and current_route
                else 0
            )

            for insert_position in range(
                min_position,
                len(current_route) + 1,
            ):
                candidate_route = current_route.copy()
                candidate_route.insert(
                    insert_position,
                    delivery_name,
                )

                candidate_metrics = calculate_remaining_route(
                    G,
                    vehicle_id,
                    state,
                    candidate_route,
                    depot_node,
                    delivery_nodes,
                    service_time_min,
                )

                candidates.append({
                    "delivery": delivery_name,
                    "vehicle_id": vehicle_id,
                    "insert_position": insert_position,
                    "remaining_before": len(current_route),
                    "added_time_min": (
                        candidate_metrics["remaining_time_min"]
                        - current_metrics["remaining_time_min"]
                    ),
                    "added_distance_km": (
                        candidate_metrics["distance_km"]
                        - current_metrics["distance_km"]
                    ),
                    "final_remaining_time_min": (
                        candidate_metrics["remaining_time_min"]
                    ),
                    "within_limit": (
                        candidate_metrics["remaining_time_min"]
                        <= max_remaining_time_min
                    ),
                    "new_route": candidate_route,
                })

        feasible = [
            c for c in candidates
            if c["within_limit"]
        ]

        if feasible:
            t_norm = minmax_normalize([
                c["added_time_min"]
                for c in feasible
            ])

            d_norm = minmax_normalize([
                c["added_distance_km"]
                for c in feasible
            ])

            f_norm = minmax_normalize([
                c["final_remaining_time_min"]
                for c in feasible
            ])

            for i, c in enumerate(feasible):
                weighted_cost = (
                    WEIGHT_ADDED_TIME * t_norm[i]
                    + WEIGHT_ADDED_DISTANCE * d_norm[i]
                    + WEIGHT_FINAL_TIME * f_norm[i]
                )

                c["decision_score"] = (
                    100 * (1 - weighted_cost)
                )

            feasible.sort(
                key=lambda x: (
                    -x["decision_score"],
                    x["added_time_min"],
                    x["added_distance_km"],
                    x["final_remaining_time_min"],
                )
            )

            best = feasible[0]

            working_routes[best["vehicle_id"]] = (
                best["new_route"]
            )

            assignment_rows.append({
                "delivery": delivery_name,
                "assigned_vehicle": best["vehicle_id"],
                "insert_position": best["insert_position"] + 1,
                "added_distance_km": best["added_distance_km"],
                "added_time_min": best["added_time_min"],
                "final_remaining_time_min": best["final_remaining_time_min"],
                "decision_score": best["decision_score"],
            })

            selected_key = (
                best["vehicle_id"],
                best["insert_position"],
            )

        else:
            best = None
            selected_key = None

            if candidates:
                best_infeasible = sorted(
                    candidates,
                    key=lambda x: (
                        max(
                            0,
                            x["final_remaining_time_min"]
                            - max_remaining_time_min,
                        ),
                        x["added_time_min"],
                        x["added_distance_km"],
                    ),
                )[0]

                unassigned_rows.append({
                    "delivery": delivery_name,
                    "best_candidate_vehicle": best_infeasible["vehicle_id"],
                    "best_candidate_final_time_min": (
                        best_infeasible["final_remaining_time_min"]
                    ),
                    "overload_min": (
                        best_infeasible["final_remaining_time_min"]
                        - max_remaining_time_min
                    ),
                })
            else:
                unassigned_rows.append({
                    "delivery": delivery_name,
                    "best_candidate_vehicle": np.nan,
                    "best_candidate_final_time_min": np.nan,
                    "overload_min": np.nan,
                })

        for c in candidates:
            decision_score = c.get("decision_score", 0.0)

            candidate_rows.append({
                "delivery": delivery_name,
                "vehicle_id": c["vehicle_id"],
                "insert_position": c["insert_position"] + 1,
                "현재_남은배송건수": c["remaining_before"],
                "추가거리_km": c["added_distance_km"],
                "추가시간_min": c["added_time_min"],
                "재배차후_남은운행시간_min": c["final_remaining_time_min"],
                "허용시간충족": c["within_limit"],
                "의사결정점수": decision_score,
                "최종선택": (
                    selected_key is not None
                    and (
                        c["vehicle_id"],
                        c["insert_position"],
                    ) == selected_key
                ),
            })

    return {
        "failed_deliveries": failed_deliveries,
        "new_routes": working_routes,
        "candidate_df": pd.DataFrame(candidate_rows),
        "assignment_df": pd.DataFrame(assignment_rows),
        "unassigned_df": pd.DataFrame(unassigned_rows),
    }


