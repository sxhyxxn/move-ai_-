KNOWLEDGE_PATH = DATA_DIR / "knowledge.csv"
ROUTES_BEFORE_PATH = DATA_DIR / "routes_before_v2.csv"

DEFAULT_SPEED_KMH = 30.0
DEFAULT_SERVICE_MIN = 5
DEFAULT_MAX_REMAINING_TIME_MIN = 65.0
MARGIN_M = 5000

WEIGHT_ADDED_TIME = 0.60
WEIGHT_ADDED_DISTANCE = 0.25
WEIGHT_FINAL_TIME = 0.15

VEHICLE_COLORS = {
    1: [31, 119, 180],
    2: [214, 39, 40],
    3: [44, 160, 44],
    4: [148, 103, 189],
