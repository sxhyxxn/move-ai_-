
from pathlib import Path
import math
import re
import warnings

import numpy as np
import pandas as pd
import geopandas as gpd
import networkx as nx
import pydeck as pdk
import streamlit as st

from pyproj import Transformer
from shapely.geometry import LineString, MultiLineString

warnings.filterwarnings("ignore")

# ============================================================
# LOGI-COPILOT Streamlit MVP v8
#
# 핵심 개선
# 1. 사용자는 "고장 차량 + 마지막 완료 배송지"만 입력
# 2. 해당 시점까지의 경과시간을 고장 차량 경로에서 자동 계산
# 3. 동일한 경과시간을 기준으로 정상 차량들의 현재 위치를 자동 추정
# 4. 고장 차량의 남은 배송만 재배차
# 5. 정상 차량의 현재 위치 + 남은 배송을 기준으로 모든 삽입 후보 평가
# 6. 후보 비교표 / 의사결정 점수 / 도로망 기반 경로 지도 제공
# ============================================================

st.set_page_config(page_title="LOGI-COPILOT", page_icon="🚚", layout="wide")

# GitHub 저장소 기준: app.py와 같은 위치의 data/ 폴더 사용
BASE_DIR = Path(__file__).resolve().parent
DATA_DIR = BASE_DIR / "data"

ROAD_SHP_PATH = DATA_DIR / "seoul.shp"
DEPOT_PATH = DATA_DIR / "depot.csv"
DRIVERS_PATH = DATA_DIR / "drivers.csv"
DELIVERIES_PATH = DATA_DIR / "deliveries.csv"
KNOWLEDGE_PATH = DATA_DIR / "knowledge.csv"
ROUTES_BEFORE_PATH = DATA_DIR / "routes_before_v2.csv"

DEFAULT_SPEED_KMH = 30.0
DEFAULT_SERVICE_MIN = 5
DEFAULT_MAX_REMAINING_TIME_MIN = 65.0
MARGIN_M = 5000

WEIGHT_ADDED_TIME = 0.60
WEIGHT_ADDED_DISTANCE = 0.25
WEIGHT_FINAL_TIME = 0.15


def check_required_files():
    required = [
        ROAD_SHP_PATH, DEPOT_PATH, DRIVERS_PATH,
        DELIVERIES_PATH, KNOWLEDGE_PATH, ROUTES_BEFORE_PATH
    ]
    missing = [str(p) for p in required if not p.exists()]
    if missing:
        st.error("필수 파일을 찾을 수 없습니다.")
        st.code("\n".join(missing))
        st.stop()


def extract_delivery_names(route_string):
    return re.findall(r"배송지_\d+", str(route_string))


def round_node(x, y):
    return (round(float(x), 2), round(float(y), 2))


def add_line_to_graph(G, line, speed_kmh):
    coords = list(line.coords)
    if len(coords) < 2:
        return

    speed_mps = speed_kmh * 1000 / 3600

    for i in range(len(coords) - 1):
        u = round_node(coords[i][0], coords[i][1])
        v = round_node(coords[i + 1][0], coords[i + 1][1])

        if u == v:
            continue

        length_m = math.hypot(v[0] - u[0], v[1] - u[1])
        if length_m <= 0:
            continue

        travel_time_sec = length_m / speed_mps

        # MVP 단순화: 양방향 처리
        G.add_edge(u, v, length_m=length_m, travel_time_sec=travel_time_sec)
        G.add_edge(v, u, length_m=length_m, travel_time_sec=travel_time_sec)


def minmax_normalize(values):
    values = np.asarray(values, dtype=float)
    if len(values) == 0:
        return values

    vmin = np.nanmin(values)
    vmax = np.nanmax(values)

    if not np.isfinite(vmin) or not np.isfinite(vmax) or abs(vmax - vmin) < 1e-9:
        return np.zeros(len(values))

    return (values - vmin) / (vmax - vmin)


@st.cache_data
def load_base_data():
    return (
        pd.read_csv(DEPOT_PATH),
        pd.read_csv(DRIVERS_PATH),
        pd.read_csv(DELIVERIES_PATH),
        pd.read_csv(KNOWLEDGE_PATH),
        pd.read_csv(ROUTES_BEFORE_PATH),
    )


def make_original_routes(routes_before_df):
    routes = {}
    for _, row in routes_before_df.iterrows():
        vehicle_id = int(row["vehicle_id"])
        routes[vehicle_id] = extract_delivery_names(row["route"])
    return routes


@st.cache_resource(show_spinner="도로 네트워크를 준비하는 중입니다...")
def build_network():
    depot_df = pd.read_csv(DEPOT_PATH)
    drivers_df = pd.read_csv(DRIVERS_PATH)
    deliveries_df = pd.read_csv(DELIVERIES_PATH)

    roads = gpd.read_file(ROAD_SHP_PATH)

    if roads.empty:
        raise ValueError("도로 SHP가 비어 있습니다.")
    if roads.crs is None:
        raise ValueError("도로 SHP의 CRS 정보가 없습니다.")

    roads_m = roads.to_crs(epsg=5179)
    roads_m = roads_m[
        roads_m.geometry.notna() & ~roads_m.geometry.is_empty
    ].copy()

    all_x = pd.concat([depot_df["node_x"], drivers_df["node_x"], deliveries_df["node_x"]])
    all_y = pd.concat([depot_df["node_y"], drivers_df["node_y"], deliveries_df["node_y"]])

    xmin = all_x.min() - MARGIN_M
    xmax = all_x.max() + MARGIN_M
    ymin = all_y.min() - MARGIN_M
    ymax = all_y.max() + MARGIN_M

    roads_m = roads_m.cx[xmin:xmax, ymin:ymax].copy()

    if roads_m.empty:
        raise ValueError("분석지역에 해당하는 도로가 없습니다.")

    speed_col = None
    for col in ["MAX_SPD", "MAX_SPEED", "SPEED", "SPD"]:
        if col in roads_m.columns:
            speed_col = col
            break

    G = nx.DiGraph()

    for _, row in roads_m.iterrows():
        speed_kmh = DEFAULT_SPEED_KMH

        if speed_col is not None:
            try:
                value = float(row[speed_col])
                if np.isfinite(value) and value > 0:
                    speed_kmh = value
            except:
                pass

        geom = row.geometry

        if isinstance(geom, LineString):
            add_line_to_graph(G, geom, speed_kmh)
        elif isinstance(geom, MultiLineString):
            for line in geom.geoms:
                add_line_to_graph(G, line, speed_kmh)

    if G.number_of_nodes() == 0:
        raise ValueError("도로 그래프 생성에 실패했습니다.")

    components = list(nx.weakly_connected_components(G))
    largest_component = max(components, key=len)
    G = G.subgraph(largest_component).copy()

    graph_nodes = np.array(list(G.nodes), dtype=float)

    def nearest_graph_node(x, y):
        d2 = (graph_nodes[:, 0] - x) ** 2 + (graph_nodes[:, 1] - y) ** 2
        idx = np.argmin(d2)
        return tuple(graph_nodes[idx])

    depot_node = nearest_graph_node(
        depot_df.iloc[0]["node_x"], depot_df.iloc[0]["node_y"]
    )

    driver_nodes = {}
    for _, row in drivers_df.iterrows():
        vehicle_id = int(row["vehicle_id"])
        driver_nodes[vehicle_id] = nearest_graph_node(row["node_x"], row["node_y"])

    delivery_nodes = {}
    for _, row in deliveries_df.iterrows():
        delivery_nodes[row["name"]] = nearest_graph_node(row["node_x"], row["node_y"])

    transformer = Transformer.from_crs("EPSG:5179", "EPSG:4326", always_xy=True)

    return G, depot_node, driver_nodes, delivery_nodes, transformer, speed_col


def get_path_metrics(G, start_node, end_node, path_cache):
    key = (start_node, end_node)

    if key in path_cache:
        return path_cache[key]

    path = nx.shortest_path(G, start_node, end_node, weight="travel_time_sec")

    distance_m = 0.0
    travel_time_sec = 0.0

    for i in range(len(path) - 1):
        edge = G[path[i]][path[i + 1]]
        distance_m += float(edge["length_m"])
        travel_time_sec += float(edge["travel_time_sec"])

    result = {
        "path": path,
        "distance_m": distance_m,
        "travel_time_sec": travel_time_sec,
    }

    path_cache[key] = result
    return result


def get_node_at_elapsed_seconds(G, path_nodes, elapsed_sec):
    if not path_nodes:
        return None

    if len(path_nodes) == 1 or elapsed_sec <= 0:
        return path_nodes[0]

    cumulative = 0.0

    for i in range(len(path_nodes) - 1):
        edge = G[path_nodes[i]][path_nodes[i + 1]]
        seg_sec = float(edge["travel_time_sec"])

        if cumulative + seg_sec >= elapsed_sec:
            return path_nodes[i]

        cumulative += seg_sec

    return path_nodes[-1]


def make_service_times(deliveries_df, knowledge_df):
    extra_delay = {name: 0 for name in deliveries_df["name"]}

    for _, row in knowledge_df.iterrows():
        location = row["location"]
        if location in extra_delay:
            extra_delay[location] += int(row["extra_delay_min"])

    service_time_min = {}
    for _, row in deliveries_df.iterrows():
        name = row["name"]
        service_time_min[name] = DEFAULT_SERVICE_MIN + extra_delay.get(name, 0)

    knowledge_check_df = pd.DataFrame({
        "배송지": deliveries_df["name"],
        "기본서비스시간_min": DEFAULT_SERVICE_MIN,
        "현장지식추가시간_min": deliveries_df["name"].map(extra_delay),
        "총서비스시간_min": deliveries_df["name"].map(service_time_min),
    })

    return service_time_min, knowledge_check_df


def compute_incident_elapsed_time(
    G,
    failed_vehicle,
    last_completed_delivery,
    original_routes,
    driver_nodes,
    delivery_nodes,
    service_time_min,
):
    """
    고장 차량이 마지막 완료 배송까지 실제로 경과한 시간을 계산.
    이동시간 + 완료 배송지의 서비스시간 누적.
    """
    route = original_routes[failed_vehicle]
    path_cache = {}

    if last_completed_delivery == "출발 전":
        return 0.0

    if last_completed_delivery not in route:
        raise ValueError("선택한 배송지가 해당 차량 경로에 없습니다.")

    elapsed_min = 0.0
    current_node = driver_nodes[failed_vehicle]

    for delivery_name in route:
        target_node = delivery_nodes[delivery_name]

        result = get_path_metrics(G, current_node, target_node, path_cache)
        elapsed_min += result["travel_time_sec"] / 60
        elapsed_min += service_time_min[delivery_name]

        current_node = target_node

        if delivery_name == last_completed_delivery:
            break

    return elapsed_min


def simulate_vehicle_state_at_time(
    G,
    vehicle_id,
    elapsed_min,
    route,
    start_node,
    depot_node,
    delivery_nodes,
    service_time_min,
):
    """
    동일한 경과시간에 차량이 어디에 있는지 자동 추정.
    - 이동 중이면 해당 도로 경로상의 위치
    - 서비스 중이면 배송지 노드
    - 완료한 배송은 remaining_route에서 제외
    """
    path_cache = {}
    remaining_sec = elapsed_min * 60
    current_node = start_node
    completed = []
    full_elapsed_path = [start_node]

    for idx, delivery_name in enumerate(route):
        target_node = delivery_nodes[delivery_name]
        result = get_path_metrics(G, current_node, target_node, path_cache)

        travel_sec = result["travel_time_sec"]

        if remaining_sec < travel_sec:
            path = result["path"]
            node = get_node_at_elapsed_seconds(G, path, remaining_sec)
            remaining_route = route[idx:].copy()

            return {
                "current_node": node,
                "completed": completed.copy(),
                "remaining_route": remaining_route,
                "status": f"{delivery_name}로 이동 중",
                "next_delivery": delivery_name,
                "elapsed_path": full_elapsed_path + path[1:],
            }

        remaining_sec -= travel_sec
        full_elapsed_path.extend(result["path"][1:])
        current_node = target_node

        service_sec = service_time_min[delivery_name] * 60

        if remaining_sec < service_sec:
            remaining_route = route[idx:].copy()

            return {
                "current_node": current_node,
                "completed": completed.copy(),
                "remaining_route": remaining_route,
                "status": f"{delivery_name} 배송/하역 중",
                "next_delivery": delivery_name,
                "elapsed_path": full_elapsed_path.copy(),
            }

        remaining_sec -= service_sec
        completed.append(delivery_name)

    # 모든 배송 완료 후 물류센터 복귀 중
    result = get_path_metrics(G, current_node, depot_node, path_cache)

    if remaining_sec < result["travel_time_sec"]:
        node = get_node_at_elapsed_seconds(G, result["path"], remaining_sec)

        return {
            "current_node": node,
            "completed": completed.copy(),
            "remaining_route": [],
            "status": "물류센터 복귀 중",
            "next_delivery": "-",
            "elapsed_path": full_elapsed_path + result["path"][1:],
        }

    return {
        "current_node": depot_node,
        "completed": completed.copy(),
        "remaining_route": [],
        "status": "운행 완료",
        "next_delivery": "-",
        "elapsed_path": full_elapsed_path + result["path"][1:],
    }


def make_all_vehicle_states(
    G,
    incident_elapsed_min,
    original_routes,
    driver_nodes,
    depot_node,
    delivery_nodes,
    service_time_min,
):
    current_nodes = {}
    remaining_routes = {}
    state_rows = []

    for vehicle_id, route in original_routes.items():
        state = simulate_vehicle_state_at_time(
            G=G,
            vehicle_id=vehicle_id,
            elapsed_min=incident_elapsed_min,
            route=route,
            start_node=driver_nodes[vehicle_id],
            depot_node=depot_node,
            delivery_nodes=delivery_nodes,
            service_time_min=service_time_min,
        )

        current_nodes[vehicle_id] = state["current_node"]
        remaining_routes[vehicle_id] = state["remaining_route"]

        state_rows.append({
            "vehicle_id": vehicle_id,
            "완료배송건수": len(state["completed"]),
            "현재상태": state["status"],
            "다음배송": state["next_delivery"],
            "남은배송건수": len(state["remaining_route"]),
        })

    return current_nodes, remaining_routes, pd.DataFrame(state_rows)


def run_reassignment(
    G,
    depot_node,
    current_nodes,
    remaining_routes,
    deliveries_df,
    knowledge_df,
    failed_vehicle,
    max_remaining_time_min,
):
    service_time_min, knowledge_check_df = make_service_times(deliveries_df, knowledge_df)

    vehicle_routes = {
        vehicle_id: route.copy()
        for vehicle_id, route in remaining_routes.items()
    }

    failed_deliveries = vehicle_routes.get(failed_vehicle, []).copy()
    original_remaining_routes = {
        vehicle_id: route.copy()
        for vehicle_id, route in vehicle_routes.items()
    }

    vehicle_routes.pop(failed_vehicle, None)

    path_cache = {}

    def calculate_route(vehicle_id, delivery_route):
        nodes = [current_nodes[vehicle_id]]

        for delivery_name in delivery_route:
            nodes.append(delivery_nodes[delivery_name])

        nodes.append(depot_node)

        total_distance_m = 0.0
        total_travel_time_sec = 0.0
        full_path = []

        for i in range(len(nodes) - 1):
            result = get_path_metrics(G, nodes[i], nodes[i + 1], path_cache)

            total_distance_m += result["distance_m"]
            total_travel_time_sec += result["travel_time_sec"]

            if not full_path:
                full_path.extend(result["path"])
            else:
                full_path.extend(result["path"][1:])

        total_service_min = sum(service_time_min[name] for name in delivery_route)
        travel_time_min = total_travel_time_sec / 60
        estimated_time_min = travel_time_min + total_service_min

        return {
            "distance_km": total_distance_m / 1000,
            "travel_time_min": travel_time_min,
            "service_time_min": total_service_min,
            "estimated_time_min": estimated_time_min,
            "path_nodes": full_path,
        }

    candidate_log_rows = []
    reassignment_log = []
    unassigned_log = []

    def evaluate_all_candidates(delivery_name):
        candidates = []

        for vehicle_id, current_route in vehicle_routes.items():
            current_metrics = calculate_route(vehicle_id, current_route)

            for insert_position in range(len(current_route) + 1):
                candidate_route = current_route.copy()
                candidate_route.insert(insert_position, delivery_name)

                candidate_metrics = calculate_route(vehicle_id, candidate_route)

                added_time = (
                    candidate_metrics["estimated_time_min"]
                    - current_metrics["estimated_time_min"]
                )

                added_distance = (
                    candidate_metrics["distance_km"]
                    - current_metrics["distance_km"]
                )

                final_time = candidate_metrics["estimated_time_min"]

                candidates.append({
                    "delivery": delivery_name,
                    "vehicle_id": vehicle_id,
                    "insert_position": insert_position,
                    "remaining_deliveries_before": len(current_route),
                    "added_time_min": added_time,
                    "added_distance_km": added_distance,
                    "final_remaining_time_min": final_time,
                    "within_limit": final_time <= max_remaining_time_min,
                    "new_route": candidate_route,
                })

        feasible = [c for c in candidates if c["within_limit"]]

        if feasible:
            t_norm = minmax_normalize([c["added_time_min"] for c in feasible])
            d_norm = minmax_normalize([c["added_distance_km"] for c in feasible])
            f_norm = minmax_normalize([c["final_remaining_time_min"] for c in feasible])

            for i, c in enumerate(feasible):
                weighted_cost = (
                    WEIGHT_ADDED_TIME * t_norm[i]
                    + WEIGHT_ADDED_DISTANCE * d_norm[i]
                    + WEIGHT_FINAL_TIME * f_norm[i]
                )
                c["decision_score"] = 100 * (1 - weighted_cost)

            feasible.sort(
                key=lambda x: (
                    -x["decision_score"],
                    x["added_time_min"],
                    x["added_distance_km"],
                    x["final_remaining_time_min"],
                )
            )
            best = feasible[0]
        else:
            best = None

        for c in candidates:
            if "decision_score" not in c:
                c["decision_score"] = 0.0

        return candidates, best

    for delivery_name in failed_deliveries:
        candidates, best = evaluate_all_candidates(delivery_name)

        if best is not None:
            selected_vehicle = best["vehicle_id"]
            selected_position = best["insert_position"]

            for c in candidates:
                candidate_log_rows.append({
                    "delivery": delivery_name,
                    "vehicle_id": c["vehicle_id"],
                    "insert_position": c["insert_position"] + 1,
                    "현재_남은배송건수": c["remaining_deliveries_before"],
                    "추가거리_km": c["added_distance_km"],
                    "추가시간_min": c["added_time_min"],
                    "재배차후_남은운행시간_min": c["final_remaining_time_min"],
                    "허용시간충족": c["within_limit"],
                    "의사결정점수": c["decision_score"],
                    "최종선택": (
                        c["vehicle_id"] == selected_vehicle
                        and c["insert_position"] == selected_position
                    ),
                })

            vehicle_routes[selected_vehicle] = best["new_route"]

            reassignment_log.append({
                "delivery": delivery_name,
                "decision": "자동 재배차",
                "assigned_vehicle": selected_vehicle,
                "insert_position": selected_position + 1,
                "added_distance_km": best["added_distance_km"],
                "added_time_min": best["added_time_min"],
                "final_remaining_time_min": best["final_remaining_time_min"],
                "decision_score": best["decision_score"],
            })

        else:
            for c in candidates:
                candidate_log_rows.append({
                    "delivery": delivery_name,
                    "vehicle_id": c["vehicle_id"],
                    "insert_position": c["insert_position"] + 1,
                    "현재_남은배송건수": c["remaining_deliveries_before"],
                    "추가거리_km": c["added_distance_km"],
                    "추가시간_min": c["added_time_min"],
                    "재배차후_남은운행시간_min": c["final_remaining_time_min"],
                    "허용시간충족": c["within_limit"],
                    "의사결정점수": 0.0,
                    "최종선택": False,
                })

            if candidates:
                best_infeasible = sorted(
                    candidates,
                    key=lambda x: (
                        max(0, x["final_remaining_time_min"] - max_remaining_time_min),
                        x["added_time_min"],
                        x["added_distance_km"],
                    ),
                )[0]

                unassigned_log.append({
                    "delivery": delivery_name,
                    "decision": "추가 차량 투입 필요",
                    "best_candidate_vehicle": best_infeasible["vehicle_id"],
                    "best_candidate_final_time_min": best_infeasible["final_remaining_time_min"],
                    "overload_min": (
                        best_infeasible["final_remaining_time_min"]
                        - max_remaining_time_min
                    ),
                })

    reassignment_df = pd.DataFrame(reassignment_log)
    unassigned_df = pd.DataFrame(unassigned_log)
    candidate_df = pd.DataFrame(candidate_log_rows)

    after_rows = []
    after_route_paths = {}

    for vehicle_id in sorted(vehicle_routes):
        route = vehicle_routes[vehicle_id]
        metrics = calculate_route(vehicle_id, route)
        after_route_paths[vehicle_id] = metrics["path_nodes"]

        route_string = f"차량 {vehicle_id} 현재위치"
        if route:
            route_string += " → " + " → ".join(route)
        route_string += " → 물류센터"

        after_rows.append({
            "vehicle_id": vehicle_id,
            "route": route_string,
            "remaining_deliveries": len(route),
            "distance_km": metrics["distance_km"],
            "travel_time_min": metrics["travel_time_min"],
            "service_time_min": metrics["service_time_min"],
            "remaining_time_min": metrics["estimated_time_min"],
            "within_limit": metrics["estimated_time_min"] <= max_remaining_time_min,
        })

    after_df = pd.DataFrame(after_rows)

    before_rows = []
    before_route_paths = {}

    for vehicle_id, route in original_remaining_routes.items():
        metrics = calculate_route(vehicle_id, route)
        before_route_paths[vehicle_id] = metrics["path_nodes"]

        route_string = f"차량 {vehicle_id} 현재위치"
        if route:
            route_string += " → " + " → ".join(route)
        route_string += " → 물류센터"

        before_rows.append({
            "vehicle_id": vehicle_id,
            "route": route_string,
            "remaining_deliveries": len(route),
            "distance_km": metrics["distance_km"],
            "travel_time_min": metrics["travel_time_min"],
            "service_time_min": metrics["service_time_min"],
            "remaining_time_min": metrics["estimated_time_min"],
        })

    before_df = pd.DataFrame(before_rows)

    decision_rows = []

    for _, row in reassignment_df.iterrows():
        decision_rows.append({
            "delivery": row["delivery"],
            "system_decision": f"차량 {int(row['assigned_vehicle'])} 자동 재배차",
            "reason": (
                f"의사결정 점수 {row['decision_score']:.1f}점, "
                f"추가시간 {row['added_time_min']:.2f}분, "
                f"추가거리 {row['added_distance_km']:.2f}km"
            ),
        })

    for _, row in unassigned_df.iterrows():
        decision_rows.append({
            "delivery": row["delivery"],
            "system_decision": "추가 차량 투입 필요",
            "reason": (
                f"가장 유리한 차량 {int(row['best_candidate_vehicle'])}도 "
                f"재배차 후 {row['best_candidate_final_time_min']:.2f}분으로 "
                f"기준보다 {row['overload_min']:.2f}분 초과"
            ),
        })

    decision_summary_df = pd.DataFrame(decision_rows)

    return {
        "before_df": before_df,
        "after_df": after_df,
        "reassignment_df": reassignment_df,
        "unassigned_df": unassigned_df,
        "candidate_df": candidate_df,
        "decision_summary_df": decision_summary_df,
        "knowledge_check_df": knowledge_check_df,
        "failed_deliveries": failed_deliveries,
        "before_route_paths": before_route_paths,
        "after_route_paths": after_route_paths,
    }


VEHICLE_COLORS = {
    1: [31, 119, 180],
    2: [214, 39, 40],
    3: [44, 160, 44],
    4: [148, 103, 189],
    5: [255, 127, 14],
    6: [23, 190, 207],
}


def node_to_lonlat(node, transformer):
    lon, lat = transformer.transform(float(node[0]), float(node[1]))
    return [lon, lat]


def make_route_map_df(route_paths, transformer):
    rows = []

    for vehicle_id, path_nodes in route_paths.items():
        if not path_nodes:
            continue

        rows.append({
            "vehicle_id": vehicle_id,
            "차량": f"차량 {vehicle_id}",
            "path": [node_to_lonlat(node, transformer) for node in path_nodes],
            "color": VEHICLE_COLORS.get(vehicle_id, [90, 90, 90]),
        })

    return pd.DataFrame(rows)


def get_progress_marker(path, progress_pct):
    if not path:
        return None

    idx = int(round((len(path) - 1) * progress_pct / 100))
    idx = min(max(idx, 0), len(path) - 1)
    return path[idx]


def render_route_map(route_paths, transformer, deliveries_df, depot_df, key_name):
    route_map_df = make_route_map_df(route_paths, transformer)

    if route_map_df.empty:
        st.info("표시할 차량 경로가 없습니다.")
        return

    progress_pct = st.slider(
        "차량 이동 시뮬레이션 진행률",
        0, 100, 0, 5,
        key=f"progress_{key_name}",
    )

    marker_rows = []

    for _, row in route_map_df.iterrows():
        marker = get_progress_marker(row["path"], progress_pct)
        if marker is not None:
            marker_rows.append({
                "차량": row["차량"],
                "lon": marker[0],
                "lat": marker[1],
                "color": row["color"],
            })

    marker_df = pd.DataFrame(marker_rows)

    delivery_points = deliveries_df[["name", "lon", "lat"]].copy()
    depot_points = pd.DataFrame([{
        "name": "물류센터",
        "lon": float(depot_df.iloc[0]["lon"]),
        "lat": float(depot_df.iloc[0]["lat"]),
    }])

    layers = [
        pdk.Layer(
            "PathLayer",
            data=route_map_df,
            get_path="path",
            get_color="color",
            width_min_pixels=4,
            pickable=True,
        ),
        pdk.Layer(
            "ScatterplotLayer",
            data=delivery_points,
            get_position="[lon, lat]",
            get_radius=55,
            get_fill_color=[110, 110, 110, 150],
            pickable=True,
        ),
        pdk.Layer(
            "ScatterplotLayer",
            data=depot_points,
            get_position="[lon, lat]",
            get_radius=100,
            get_fill_color=[0, 0, 0, 210],
            pickable=True,
        ),
    ]

    if not marker_df.empty:
        layers.append(
            pdk.Layer(
                "ScatterplotLayer",
                data=marker_df,
                get_position="[lon, lat]",
                get_radius=110,
                get_fill_color="color",
                get_line_color=[255, 255, 255],
                line_width_min_pixels=2,
                stroked=True,
                pickable=True,
            )
        )

    all_lons = list(delivery_points["lon"]) + list(depot_points["lon"])
    all_lats = list(delivery_points["lat"]) + list(depot_points["lat"])

    for path in route_map_df["path"]:
        all_lons.extend([p[0] for p in path])
        all_lats.extend([p[1] for p in path])

    view_state = pdk.ViewState(
        longitude=float(np.mean(all_lons)),
        latitude=float(np.mean(all_lats)),
        zoom=11.5,
        pitch=0,
    )

    st.pydeck_chart(
        pdk.Deck(
            layers=layers,
            initial_view_state=view_state,
            map_style=None,
            tooltip={"html": "<b>{차량}</b><br>{name}"},
        ),
        use_container_width=True,
    )


