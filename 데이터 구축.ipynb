# ============================================================
# LOGI-COPILOT MVP
# SHP 도로망 기반 가상 배송 데이터 + VRP + 돌발상황 재배차
# Jupyter Notebook용 단일 실행 코드
# ============================================================

from pathlib import Path
import random
import math
import warnings

import numpy as np
import pandas as pd
import geopandas as gpd
import networkx as nx
import matplotlib.pyplot as plt

from shapely.geometry import LineString, MultiLineString
from ortools.constraint_solver import pywrapcp, routing_enums_pb2

warnings.filterwarnings("ignore")


# ============================================================
# 0. 기본 설정
# ============================================================

# GitHub 저장소 기준
DATA_DIR = Path("data")

# data 폴더 안의 서울 도로망 SHP
ROAD_SHP_PATH = DATA_DIR / "seoul.shp"

# 결과는 저장소 최상위의 별도 폴더에 저장
OUTPUT_DIR = Path("logi_copilot_output")
OUTPUT_DIR.mkdir(exist_ok=True)

RANDOM_SEED = 42

# MVP 규모
N_DRIVERS = 5
N_DELIVERIES = 20

# SHP에 속도 정보가 없을 경우 사용할 평균속도
DEFAULT_SPEED_KMH = 30.0

# OR-Tools 계산 제한시간
SOLVE_TIME_SEC = 10

random.seed(RANDOM_SEED)
np.random.seed(RANDOM_SEED)


print("=" * 70)
print("LOGI-COPILOT MVP")
print("=" * 70)
print("현재 경로 :", Path.cwd())
print("도로 SHP  :", ROAD_SHP_PATH)
print("결과 폴더 :", OUTPUT_DIR)


if not ROAD_SHP_PATH.exists():
    raise FileNotFoundError(
        f"\nSHP 파일을 찾을 수 없습니다.\n"
        f"확인 경로: {ROAD_SHP_PATH.resolve()}"
    )


# ============================================================
# 1. SHP 읽기
# ============================================================

print("\n[1/9] 도로 SHP 읽는 중...")

roads = gpd.read_file(ROAD_SHP_PATH)

if roads.empty:
    raise ValueError("SHP 파일에 도로 링크가 없습니다.")

print("링크 수:", f"{len(roads):,}")
print("CRS:", roads.crs)
print("컬럼:")
print(roads.columns.tolist())


# ============================================================
# 2. 미터 단위 CRS로 변환
# ============================================================

print("\n[2/9] 좌표계 확인...")

if roads.crs is None:
    raise ValueError(
        "SHP에 CRS 정보가 없습니다. "
        ".prj 파일이 data 폴더에 함께 있는지 확인해주세요."
    )

# 경위도 좌표계라면 거리 계산을 위해 EPSG:5179로 변환
if roads.crs.is_geographic:
    roads_m = roads.to_crs(epsg=5179)
    print("경위도 좌표 → EPSG:5179 변환")
else:
    roads_m = roads.copy()
    print("기존 투영좌표계 사용:", roads_m.crs)

# geometry 없는 데이터 제거
roads_m = roads_m[
    roads_m.geometry.notna()
    & (~roads_m.geometry.is_empty)
].copy()

print("유효 링크:", f"{len(roads_m):,}")


# ============================================================
# 3. NetworkX 도로망 그래프 생성
# ============================================================

print("\n[3/9] NetworkX 도로망 생성 중...")


def round_coord(coord, precision=2):
    """
    너무 미세한 좌표 차이 때문에 동일 교차로가
    별도 노드로 생성되는 것을 어느 정도 방지
    """
    return (
        round(float(coord[0]), precision),
        round(float(coord[1]), precision),
    )


def add_linestring_to_graph(G, geom, speed_kmh):
    """
    하나의 LineString을 NetworkX 그래프에 추가
    """

    coords = list(geom.coords)

    if len(coords) < 2:
        return

    for i in range(len(coords) - 1):

        u = round_coord(coords[i])
        v = round_coord(coords[i + 1])

        if u == v:
            continue

        dx = v[0] - u[0]
        dy = v[1] - u[1]

        length_m = math.sqrt(dx * dx + dy * dy)

        if length_m <= 0:
            continue

        speed_mps = speed_kmh * 1000 / 3600
        travel_time_sec = length_m / speed_mps

        # 정방향
        G.add_edge(
            u,
            v,
            length_m=length_m,
            travel_time_sec=travel_time_sec,
        )

        # MVP에서는 양방향 도로로 가정
        G.add_edge(
            v,
            u,
            length_m=length_m,
            travel_time_sec=travel_time_sec,
        )


# ------------------------------------------------------------
# 속도 컬럼 자동 탐색
# ------------------------------------------------------------

speed_candidates = [
    "MAX_SPD",
    "MAX_SPEED",
    "SPEED",
    "SPD",
]

speed_col = None

for c in speed_candidates:
    if c in roads_m.columns:
        speed_col = c
        break

print(
    "사용 속도 컬럼:",
    speed_col if speed_col else "없음 → 30km/h 가정",
)


# ------------------------------------------------------------
# 그래프 생성
# ------------------------------------------------------------

G = nx.DiGraph()

for _, row in roads_m.iterrows():

    geom = row.geometry
    speed_kmh = DEFAULT_SPEED_KMH

    if speed_col is not None:
        try:
            value = float(row[speed_col])

            if np.isfinite(value) and value > 0:
                speed_kmh = value

        except (TypeError, ValueError):
            pass

    if isinstance(geom, LineString):

        add_linestring_to_graph(
            G,
            geom,
            speed_kmh,
        )

    elif isinstance(geom, MultiLineString):

        for line in geom.geoms:

            add_linestring_to_graph(
                G,
                line,
                speed_kmh,
            )


print("전체 노드:", f"{G.number_of_nodes():,}")
print("전체 엣지:", f"{G.number_of_edges():,}")

if G.number_of_nodes() == 0:
    raise ValueError(
        "도로망 그래프가 생성되지 않았습니다. "
        "seoul.shp의 geometry를 확인해주세요."
    )


# ============================================================
# 4. 가장 큰 연결 네트워크만 사용
# ============================================================

print("\n[4/9] 연결된 도로망 추출 중...")

components = list(
    nx.weakly_connected_components(G)
)

largest_component = max(
    components,
    key=len,
)

G = G.subgraph(
    largest_component
).copy()

print("사용 노드:", f"{G.number_of_nodes():,}")
print("사용 엣지:", f"{G.number_of_edges():,}")


# ============================================================
# 5. 가상 물류센터 / 배송지 / 차량 생성
# ============================================================

print("\n[5/9] 가상 물류 데이터 생성 중...")

all_nodes = list(G.nodes)

required_nodes = (
    1
    + N_DRIVERS
    + N_DELIVERIES
)

if len(all_nodes) < required_nodes:
    raise ValueError(
        "도로망 노드가 너무 적습니다."
    )


# ------------------------------------------------------------
# 서울 전체에서 너무 멀리 떨어진 지점을 무작위 추출하면
# VRP 계산이 오래 걸릴 수 있으므로
# 도로망 중심부의 가까운 노드 10%를 후보로 사용
# ------------------------------------------------------------

xs = np.array(
    [n[0] for n in all_nodes]
)

ys = np.array(
    [n[1] for n in all_nodes]
)

cx = np.median(xs)
cy = np.median(ys)

dist_to_center = np.sqrt(
    (xs - cx) ** 2
    + (ys - cy) ** 2
)

threshold = np.quantile(
    dist_to_center,
    0.1,
)

candidate_nodes = [
    node
    for node, d in zip(
        all_nodes,
        dist_to_center,
    )
    if d <= threshold
]

if len(candidate_nodes) < required_nodes:
    candidate_nodes = all_nodes


sampled_nodes = random.sample(
    candidate_nodes,
    required_nodes,
)

depot_node = sampled_nodes[0]

driver_nodes = sampled_nodes[
    1:1 + N_DRIVERS
]

delivery_nodes = sampled_nodes[
    1 + N_DRIVERS:
]


# ------------------------------------------------------------
# 좌표를 WGS84 경위도로 변환
# ------------------------------------------------------------

point_gdf = gpd.GeoDataFrame(
    {
        "node": sampled_nodes
    },
    geometry=gpd.points_from_xy(
        [p[0] for p in sampled_nodes],
        [p[1] for p in sampled_nodes],
    ),
    crs=roads_m.crs,
)

point_wgs = point_gdf.to_crs(
    epsg=4326
)

lonlat = {
    tuple(row["node"]): (
        row.geometry.x,
        row.geometry.y,
    )
    for _, row in point_wgs.iterrows()
}


# ------------------------------------------------------------
# 물류센터
# ------------------------------------------------------------

depot_lon, depot_lat = lonlat[
    depot_node
]

depot_df = pd.DataFrame(
    [
        {
            "depot_id": "DEPOT_01",
            "name": "물류센터",
            "node_x": depot_node[0],
            "node_y": depot_node[1],
            "lon": depot_lon,
            "lat": depot_lat,
        }
    ]
)


# ------------------------------------------------------------
# 차량
# ------------------------------------------------------------

driver_rows = []

for i, node in enumerate(
    driver_nodes,
    start=1,
):

    lon, lat = lonlat[node]

    driver_rows.append(
        {
            "driver_id": f"DRIVER_{i:02d}",
            "vehicle_id": i,
            "node_x": node[0],
            "node_y": node[1],
            "lon": lon,
            "lat": lat,
            "available": 1,
        }
    )

drivers_df = pd.DataFrame(
    driver_rows
)


# ------------------------------------------------------------
# 배송지
# ------------------------------------------------------------

delivery_rows = []

for i, node in enumerate(
    delivery_nodes,
    start=1,
):

    lon, lat = lonlat[node]

    delivery_rows.append(
        {
            "delivery_id": f"DELIVERY_{i:02d}",
            "name": f"배송지_{i:02d}",
            "node_x": node[0],
            "node_y": node[1],
            "lon": lon,
            "lat": lat,

            # 가상 배송량
            "demand": random.randint(
                1,
                5,
            ),

            # 기본 우선순위
            "priority": 1,
        }
    )

deliveries_df = pd.DataFrame(
    delivery_rows
)


# ------------------------------------------------------------
# 가상 현장 노하우
# ------------------------------------------------------------

knowledge_df = pd.DataFrame(
    [
        {
            "knowledge_id": "K001",
            "location": "배송지_03",
            "knowledge_type": "congestion",
            "description": "오후 시간대 주변 도로가 혼잡함",
            "extra_delay_min": 15,
        },
        {
            "knowledge_id": "K002",
            "location": "배송지_07",
            "knowledge_type": "unloading",
            "description": "하역 시간이 일반 배송지보다 오래 걸림",
            "extra_delay_min": 20,
        },
        {
            "knowledge_id": "K003",
            "location": "배송지_12",
            "knowledge_type": "access",
            "description": "대형 차량 진입이 어려움",
            "extra_delay_min": 10,
        },
    ]
)


# ------------------------------------------------------------
# CSV 저장
# ------------------------------------------------------------

depot_df.to_csv(
    OUTPUT_DIR / "depot.csv",
    index=False,
    encoding="utf-8-sig",
)

drivers_df.to_csv(
    OUTPUT_DIR / "drivers.csv",
    index=False,
    encoding="utf-8-sig",
)

deliveries_df.to_csv(
    OUTPUT_DIR / "deliveries.csv",
    index=False,
    encoding="utf-8-sig",
)

knowledge_df.to_csv(
    OUTPUT_DIR / "knowledge.csv",
    index=False,
    encoding="utf-8-sig",
)


print("\nCSV 생성 완료")

print(
    OUTPUT_DIR / "depot.csv"
)

print(
    OUTPUT_DIR / "drivers.csv"
)

print(
    OUTPUT_DIR / "deliveries.csv"
)

print(
    OUTPUT_DIR / "knowledge.csv"
)


# ============================================================
# 6. VRP용 위치 설정
# ============================================================

print("\n[6/9] 도로 최단거리 행렬 계산 중...")

# 위치 0 = 물류센터
# 위치 1~N = 배송지

locations = [
    depot_node
] + delivery_nodes

location_names = [
    "물류센터"
] + deliveries_df[
    "name"
].tolist()

n_locations = len(
    locations
)


# ------------------------------------------------------------
# 한 번의 Dijkstra로
# 각 출발점에서 모든 배송지까지의 거리 계산
# ------------------------------------------------------------

distance_matrix = np.zeros(
    (
        n_locations,
        n_locations,
    ),
    dtype=np.int64,
)


for i, source in enumerate(
    locations
):

    lengths = (
        nx.single_source_dijkstra_path_length(
            G,
            source,
            weight="length_m",
        )
    )

    for j, target in enumerate(
        locations
    ):

        if source == target:

            distance_matrix[
                i,
                j,
            ] = 0

        else:

            d = lengths.get(
                target
            )

            if d is None:

                distance_matrix[
                    i,
                    j,
                ] = 10**9

            else:

                distance_matrix[
                    i,
                    j,
                ] = int(
                    round(d)
                )


print(
    "거리행렬 크기:",
    distance_matrix.shape,
)

finite_values = distance_matrix[
    distance_matrix < 10**9
]

print(
    "평균 배송지간 거리:",
    round(
        finite_values.mean() / 1000,
        2,
    ),
    "km",
)


# ============================================================
# 7. OR-Tools VRP 함수
# ============================================================

def solve_vrp(
    distance_matrix,
    n_vehicles,
    disabled_vehicle=None,
):
    """
    거리 최소화 기본 VRP

    disabled_vehicle:
        1부터 시작하는 차량 번호.
        해당 차량은 사용하지 않음.
    """

    if disabled_vehicle is None:

        active_vehicle_ids = list(
            range(
                1,
                n_vehicles + 1,
            )
        )

    else:

        active_vehicle_ids = [
            i
            for i in range(
                1,
                n_vehicles + 1,
            )
            if i != disabled_vehicle
        ]

    active_n = len(
        active_vehicle_ids
    )

    if active_n == 0:
        raise ValueError(
            "사용 가능한 차량이 없습니다."
        )

    data = {
        "distance_matrix":
            distance_matrix.tolist(),

        "num_vehicles":
            active_n,

        "depot":
            0,
    }

    manager = pywrapcp.RoutingIndexManager(
        len(
            data[
                "distance_matrix"
            ]
        ),
        data[
            "num_vehicles"
        ],
        data[
            "depot"
        ],
    )

    routing = pywrapcp.RoutingModel(
        manager
    )


    # --------------------------------------------------------
    # 거리 Callback
    # --------------------------------------------------------

    def distance_callback(
        from_index,
        to_index,
    ):

        from_node = manager.IndexToNode(
            from_index
        )

        to_node = manager.IndexToNode(
            to_index
        )

        return data[
            "distance_matrix"
        ][
            from_node
        ][
            to_node
        ]


    transit_callback_index = (
        routing.RegisterTransitCallback(
            distance_callback
        )
    )

    routing.SetArcCostEvaluatorOfAllVehicles(
        transit_callback_index
    )


    # --------------------------------------------------------
    # 차량 한 대에 배송이 지나치게 몰리지 않도록
    # 최대 경로거리 기준을 느슨하게 설정
    # --------------------------------------------------------

    finite_values = (
        distance_matrix[
            distance_matrix < 10**9
        ]
    )

    max_edge = int(
        finite_values.max()
    )

    max_route_distance = max(
        max_edge
        * len(distance_matrix),
        100000,
    )


    routing.AddDimension(
        transit_callback_index,
        0,
        max_route_distance,
        True,
        "Distance",
    )


    distance_dimension = (
        routing.GetDimensionOrDie(
            "Distance"
        )
    )

    # 차량별 경로 길이 균형 고려
    distance_dimension.SetGlobalSpanCostCoefficient(
        50
    )


    # --------------------------------------------------------
    # 탐색 설정
    # --------------------------------------------------------

    search_parameters = (
        pywrapcp.DefaultRoutingSearchParameters()
    )

    search_parameters.first_solution_strategy = (
        routing_enums_pb2
        .FirstSolutionStrategy
        .PATH_CHEAPEST_ARC
    )

    search_parameters.local_search_metaheuristic = (
        routing_enums_pb2
        .LocalSearchMetaheuristic
        .GUIDED_LOCAL_SEARCH
    )

    search_parameters.time_limit.seconds = (
        SOLVE_TIME_SEC
    )


    solution = routing.SolveWithParameters(
        search_parameters
    )

    if solution is None:

        raise RuntimeError(
            "VRP 해를 찾지 못했습니다."
        )


    # --------------------------------------------------------
    # 결과 추출
    # --------------------------------------------------------

    route_results = []

    for internal_vehicle_id in range(
        active_n
    ):

        original_vehicle_id = (
            active_vehicle_ids[
                internal_vehicle_id
            ]
        )

        index = routing.Start(
            internal_vehicle_id
        )

        route = []

        route_distance = 0

        while not routing.IsEnd(
            index
        ):

            node_index = (
                manager.IndexToNode(
                    index
                )
            )

            route.append(
                node_index
            )

            previous_index = index

            index = solution.Value(
                routing.NextVar(
                    index
                )
            )

            route_distance += (
                routing.GetArcCostForVehicle(
                    previous_index,
                    index,
                    internal_vehicle_id,
                )
            )

        route.append(
            manager.IndexToNode(
                index
            )
        )

        route_results.append(
            {
                "vehicle_id":
                    original_vehicle_id,

                "route":
                    route,

                "route_distance_m":
                    route_distance,
            }
        )

    return route_results


# ============================================================
# 8. 초기 배송 계획 계산
# ============================================================

print("\n[7/9] 초기 배송계획 계산 중...")


before_routes = solve_vrp(
    distance_matrix=
        distance_matrix,

    n_vehicles=
        N_DRIVERS,
)


def routes_to_dataframe(
    routes,
    scenario,
):

    rows = []

    for r in routes:

        route_names = [
            location_names[i]
            for i in r[
                "route"
            ]
        ]

        rows.append(
            {
                "scenario":
                    scenario,

                "vehicle_id":
                    r[
                        "vehicle_id"
                    ],

                "route":
                    " → ".join(
                        route_names
                    ),

                "distance_km":
                    r[
                        "route_distance_m"
                    ] / 1000,
            }
        )

    return pd.DataFrame(
        rows
    )


before_df = routes_to_dataframe(
    before_routes,
    "기존",
)

print("\n--- 기존 배송 계획 ---")

display(
    before_df
)


# ============================================================
# 9. 돌발상황: 2번 차량 고장
# ============================================================

FAILED_VEHICLE = 2

print(
    f"\n[8/9] 돌발상황 발생: "
    f"차량 {FAILED_VEHICLE} 운행 불가"
)


after_routes = solve_vrp(
    distance_matrix=
        distance_matrix,

    n_vehicles=
        N_DRIVERS,

    disabled_vehicle=
        FAILED_VEHICLE,
)


after_df = routes_to_dataframe(
    after_routes,
    "재배차",
)

print(
    "\n--- 차량 고장 이후 재배차 ---"
)

display(
    after_df
)


# ============================================================
# 10. Before / After 비교
# ============================================================

print("\n[9/9] 결과 비교")


before_total = before_df[
    "distance_km"
].sum()

after_total = after_df[
    "distance_km"
].sum()


comparison_df = pd.DataFrame(
    {
        "항목": [
            "사용 차량 수",
            "총 배송거리(km)",
            "최대 차량 이동거리(km)",
        ],

        "기존": [
            len(
                before_df
            ),

            before_total,

            before_df[
                "distance_km"
            ].max(),
        ],

        "차량 고장 후": [
            len(
                after_df
            ),

            after_total,

            after_df[
                "distance_km"
            ].max(),
        ],
    }
)


display(
    comparison_df.round(2)
)


