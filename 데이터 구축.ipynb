from pathlib import Path
import random
import numpy as np

# 실제 GitHub 저장소 폴더
BASE_DIR = Path.home() / "Documents" / "GitHub" / "move-ai_-"

# 서울 도로망 SHP
ROAD_SHP_PATH = BASE_DIR / "data" / "seoul.shp"

# 결과 저장 폴더
OUTPUT_DIR = BASE_DIR / "logi_copilot_output"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

RANDOM_SEED = 42
N_DRIVERS = 5
N_DELIVERIES = 20
DEFAULT_SPEED_KMH = 30.0
SOLVE_TIME_SEC = 10

random.seed(RANDOM_SEED)
np.random.seed(RANDOM_SEED)

print("=" * 70)
print("LOGI-COPILOT MVP")
print("=" * 70)

print("프로젝트 폴더 :", BASE_DIR)
print("도로 SHP      :", ROAD_SHP_PATH)
print("결과 폴더     :", OUTPUT_DIR)

print("\n[경로 확인]")
print("프로젝트 폴더 존재 :", BASE_DIR.exists())
print("도로 SHP 존재      :", ROAD_SHP_PATH.exists())

required_files = [
    BASE_DIR / "data" / "seoul.shp",
    BASE_DIR / "data" / "seoul.dbf",
    BASE_DIR / "data" / "seoul.shx",
    BASE_DIR / "data" / "seoul.prj",
]

missing_files = [
    file.name
    for file in required_files
    if not file.exists()
]

if missing_files:
    raise FileNotFoundError(
        "\n필수 도로망 파일을 찾을 수 없습니다.\n"
        f"프로젝트 폴더: {BASE_DIR}\n"
        f"누락 파일: {missing_files}"
    )

print("\n도로망 데이터 경로 설정 완료")
